          <mxGeometry x="400" y="170" width="800" height="860" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="frontend&lt;br&gt;node:26 build → nginx:alpine&lt;br&gt;&lt;br&gt;公開: ${FRONTEND_PORT} → 80&lt;br&gt;/api を backend へ proxy_pass" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="450" y="230" width="310" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="backend&lt;br&gt;python:3.14-slim / FastAPI + Uvicorn&lt;br&gt;&lt;br&gt;Compose内部のみ（通常は非公開）&lt;br&gt;起動時 alembic upgrade head&lt;br&gt;AUTH_MODE = session | jwt" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="450" y="430" width="310" height="160" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="postgres:17-alpine&lt;br&gt;&lt;br&gt;Compose内部のみ（通常は非公開）&lt;br&gt;volume: pgdata（永続化あり）&lt;br&gt;永続データ 8テーブル（notifications を含む）" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFF3E0;strokeColor=#EF6C00;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="880" y="410" width="270" height="140" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="redis:8-alpine&lt;br&gt;&lt;br&gt;Compose内部のみ（通常は非公開）&lt;br&gt;volume なし / RDB・AOF 無効&lt;br&gt;maxmemory-policy=noeviction&lt;br&gt;ログイン状態＋バッチ実行ロック&lt;br&gt;（いずれもTTL失効）" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFEBEE;strokeColor=#C62828;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="880" y="680" width="270" height="180" as="geometry" />
        </mxCell>
        <mxCell id="n10" value="mailpit（dev profile専用）&lt;br&gt;&lt;br&gt;SMTP/UI: loopbackのみ公開可&lt;br&gt;productionは外部SMTP&lt;br&gt;外部へは送信しない" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
