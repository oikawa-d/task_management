<mxfile host="app.diagrams.net"><diagram id="diagram" name="Diagram"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="760" math="0" shadow="0"><root><mxCell id="title" value="11 OAuthコールバック中継 /oauth/callback" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="30" as="geometry"/></mxCell><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="b200" value="ブラウザウィンドウ（レイアウトなし・ローディングのみ） /oauth/callback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fb;strokeColor=#E7A500;dashed=0;align=left;verticalAlign=top;spacing=6;spacingLeft=10;fontColor=#232F3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="900" height="300" as="geometry"/></mxCell><mxCell id="b201" value="認証情報を確認しています…（ローディング表示）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fb;strokeColor=#FFFFFF;dashed=0;align=center;verticalAlign=middle;spacing=6;spacingLeft=10;fontColor=#232F3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="130" width="820" height="80" as="geometry"/></mxCell><mxCell id="b202" value="jwtモード: fragmentのcodeを取得 → POST /auth/oauth/exchange を1回だけ実行 → 成功後 GET /auth/me → レスポンスの redirect_to へ遷移" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fb;strokeColor=#FFFFFF;dashed=0;align=left;verticalAlign=middle;spacing=6;spacingLeft=10;fontColor=#232F3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="230" width="820" height="60" as="geometry"/></mxCell><mxCell id="b203" value="sessionモード: 設定済みCookieでGET /auth/me → fragmentのredirect_toを同一オリジン相対パスとして再検証（違反時は /dashboard）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fb;strokeColor=#FFFFFF;dashed=0;align=left;verticalAlign=middle;spacing=6;spacingLeft=10;fontColor=#232F3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="300" width="820" height="60" as="geometry"/></mxCell><mxCell id="b204" value="codeは送信後 history.replaceState でURLから除去。失敗時は一時コードを再送しない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#8C9BAB;dashed=1;align=left;verticalAlign=top;spacing=6;spacingLeft=10;fontColor=#232F3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="900" height="60" as="geometry"/></mxCell><mxCell id="b205" value="profile_completed=false の場合: サーバーのredirect_toより優先して /settings?complete_profile=1 へ遷移" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#8C9BAB;dashed=1;align=left;verticalAlign=top;spacing=6;spacingLeft=10;fontColor=#232F3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="900" height="60" as="geometry"/></mxCell><mxCell id="legend206" value="凡例" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fb;strokeColor=#232F3E;dashed=0;align=left;verticalAlign=top;spacing=6;spacingLeft=10;fontColor=#232F3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="70" width="300" height="56" as="geometry"/></mxCell><mxCell id="lg207" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fb;strokeColor=#E7A500;dashed=0;align=left;verticalAlign=top;spacing=6;spacingLeft=10;fontColor=#232F3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="100" width="18" height="18" as="geometry"/></mxCell><mxCell id="lgt208" value="OAuth関連" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fb;strokeColor=#FFFFFF;dashed=0;align=left;verticalAlign=middle;spacing=6;spacingLeft=10;fontColor=#232F3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1026" y="96" width="254" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>