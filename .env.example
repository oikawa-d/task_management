# ==== 共通・ポート (04_env_config.md §3.1) ====
COMPOSE_PROJECT_NAME=cerberus
APP_ENV=local
LOG_LEVEL=INFO
FRONTEND_PORT=5173
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ==== データストア (§3.2) ====
POSTGRES_USER=cerberus
POSTGRES_PASSWORD=changeme
POSTGRES_DB=cerberus
DATABASE_URL=postgresql+asyncpg://cerberus:changeme@postgres:5432/cerberus
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=
REDIS_TEST_DB=1
LOGIN_HISTORY_RETENTION_DAYS=90
API_HISTORY_RETENTION_DAYS=30
BATCH_HISTORY_RETENTION_DAYS=30
API_HISTORY_BODY_MAX_BYTES=65536
API_HISTORY_ERROR_DETAIL_MAX_LENGTH=4000

# ==== 認証共通・session方式 (§3.3) ====
AUTH_MODE=session
SESSION_TTL_SECONDS=1800
SESSION_ABSOLUTE_TTL_SECONDS=28800
COOKIE_NAME_SESSION=cerberus_sid
COOKIE_NAME_CSRF=cerberus_csrf
COOKIE_NAME_OAUTH_STATE=cerberus_oauth_state
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_WINDOW_SECONDS=900
RATE_LIMIT_REGISTER_MAX_REQUESTS=5
RATE_LIMIT_EMAIL_VERIFY_MAX_REQUESTS=10
RATE_LIMIT_EMAIL_VERIFY_RESEND_MAX_REQUESTS=5
RATE_LIMIT_PASSWORD_FORGOT_MAX_REQUESTS=5
RATE_LIMIT_PASSWORD_RESET_MAX_REQUESTS=10
RATE_LIMIT_OAUTH_MAX_REQUESTS=10
RATE_LIMIT_OAUTH_WINDOW_SECONDS=900
RATE_LIMIT_NOTIFICATION_READ_MAX_REQUESTS=120
RATE_LIMIT_NOTIFICATION_WRITE_MAX_REQUESTS=60
RATE_LIMIT_NOTIFICATION_WINDOW_SECONDS=60
TRUSTED_PROXY_CIDRS=
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# ==== jwt方式 (§3.4) ====
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TTL_SECONDS=1209600
JWT_SECRET_KEY=changeme
JWT_ALGORITHM=HS256
COOKIE_NAME_REFRESH=cerberus_rt
COOKIE_SAMESITE_REFRESH=strict

# ==== CORS・API公開設定 (§3.5) ====
CORS_ALLOW_ORIGINS=http://localhost:5173
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,X-CSRF-Token,Authorization
CORS_MAX_AGE_SECONDS=600
ENABLE_API_DOCS=true

# ==== ページング (§3.6) ====
PAGINATION_DEFAULT_PER_PAGE=20
PAGINATION_MAX_PER_PAGE=100

# ==== Google OAuth2 (§3.7) ====
GOOGLE_LOGIN_ENABLED=true
GOOGLE_CLIENT_ID=changeme
GOOGLE_CLIENT_SECRET=changeme
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/oauth/google/callback
GOOGLE_AUTHORIZE_ENDPOINT=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_ENDPOINT=https://oauth2.googleapis.com/token
GOOGLE_USERINFO_ENDPOINT=https://openidconnect.googleapis.com/v1/userinfo
GOOGLE_JWKS_URI=https://www.googleapis.com/oauth2/v3/certs
GOOGLE_JWKS_CACHE_TTL_SECONDS=3600
OAUTH_STATE_TTL_SECONDS=600
OAUTH_HANDOFF_TTL_SECONDS=60
OAUTH_DEFAULT_REDIRECT_TO=/dashboard
OAUTH_REDIRECT_TO_MAX_LENGTH=2048
GOOGLE_OAUTH_PROMPT=select_account

# ==== メール（SMTP/Mailpit） (§3.8) ====
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
MAIL_FROM=no-reply@cerberus.local
FRONTEND_BASE_URL=http://localhost:5173
PASSWORD_RESET_TTL_SECONDS=1800
EMAIL_VERIFY_TTL_SECONDS=86400
EMAIL_VERIFY_RESEND_INTERVAL_SECONDS=60

# ==== 初期データ・フロント (§3.9) ====
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=changeme
VITE_API_BASE_URL=/api
VITE_NOTIFICATION_POLL_INTERVAL_MS=60000
# コメント本文のzodバリデーション上限文字数。バックエンドのTASK_COMMENT_BODY_MAX_LENGTH（既定2000）と同じ値を設定すること（basic_design/05_frontend.md §6.2）
VITE_TASK_COMMENT_BODY_MAX_LENGTH=2000
VITE_USER_NAME_MAX_LENGTH=30
VITE_PASSWORD_MIN_LENGTH=8

# ==== 通知・batch (§3.10) ====
APP_TIMEZONE=Asia/Tokyo
NOTIFY_DUE_RUN_HOURS=10,17
NOTIFY_DUE_CRON_MINUTE=0
NOTIFY_DUE_TARGET_HOUR=10
NOTIFY_DUE_LOCK_TTL_SECONDS=82800
NOTIFY_DUE_BATCH_CHUNK_SIZE=500
NOTIFICATION_RETENTION_DAYS=90
BATCH_ENABLED=true

# ==== デプロイ・イメージ管理 (§3.11、ローカルでは未使用) ====
# IMAGE_NAME_*はCDが.envへ書き出す値（ghcr.io/{owner}/cerberus-*）。
# ローカルのdocker compose upはdocker-compose.ymlの既定値（cerberus-*、ビルド利用）にフォールバックするため未設定でよい。
IMAGE_NAME_BACKEND=cerberus-backend
IMAGE_NAME_FRONTEND=cerberus-frontend
IMAGE_NAME_BATCH=cerberus-batch
BACKEND_IMAGE_TAG=latest
FRONTEND_IMAGE_TAG=latest
BATCH_IMAGE_TAG=latest
IMAGE_RETENTION_DAYS=30
DEPLOY_STATE_FILE=/var/lib/cerberus/last-successful-deploy.env

# ==== 追加項目 (§3.12) ====
CSRF_TRUST_REFERER_ON_HTTPS=false
HEALTH_CHECK_TIMEOUT_SECONDS=2
LOGIN_HISTORY_LIST_LIMIT=50
