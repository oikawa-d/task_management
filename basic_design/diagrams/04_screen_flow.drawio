        <mxCell id="e36" value="サイドバー「管理」&lt;br&gt;（admin のみ表示）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#C62828;strokeWidth=1.5;fontSize=10;fontColor=#C62828;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.909;exitDx=0;exitDy=0;entryX=0;entryY=0.429;entryDx=0;entryDy=0;" edge="1" parent="1" source="n13" target="n18">
