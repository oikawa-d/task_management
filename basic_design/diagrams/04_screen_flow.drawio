        <mxCell id="n10" value="⑪ OAuthコールバック中継&lt;br&gt;/oauth/callback&lt;br&gt;&lt;br&gt;jwtモードはfragmentの一時コードを交換" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
