        <mxCell id="n2" value="全11画面。ルーティングガード（RequireAuth / RequireAdmin）で認証・権限を判定する。ルート / は画面を持たず、常に /login へリダイレクトする。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#616161;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="1060" height="20" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="" style="ellipse;html=1;fillColor=#263238;strokeColor=#263238;" vertex="1" parent="1">
          <mxGeometry x="30" y="185" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="認証不要（ログイン/登録は未認証のみ）&lt;br&gt;AuthLayout" style="container=1;collapsible=0;rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9E9E9E;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#616161;" vertex="1" parent="1">
          <mxGeometry x="200" y="120" width="440" height="790" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="① ログイン&lt;br&gt;/login&lt;br&gt;&lt;br&gt;ID or メール + パスワード&lt;br&gt;目のアイコンで表示切替&lt;br&gt;Googleでログイン" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="270" y="160" width="340" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="② 会員登録&lt;br&gt;/register&lt;br&gt;&lt;br&gt;姓・名 / フリガナ / 生年月日&lt;br&gt;メール / パスワード×2&lt;br&gt;Googleで新規登録" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="270" y="330" width="340" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="③ パスワード再設定要求&lt;br&gt;/password/forgot&lt;br&gt;&lt;br&gt;メールアドレスを入力 → 202" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="270" y="650" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="④ パスワード再設定&lt;br&gt;/password/reset#token=xxx&lt;br&gt;&lt;br&gt;新パスワード入力 → 全セッション失効" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="270" y="800" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="Google 認可画面&lt;br&gt;（外部サイト）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F9A825;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="800" y="150" width="220" height="80" as="geometry" />
