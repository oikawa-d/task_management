        <mxCell id="e37" value="ログアウト / 401" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#90A4AE;strokeWidth=1.5;fontSize=10;fontColor=#90A4AE;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0.192;exitY=0;exitDx=0;exitDy=0;entryX=0.529;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n13" target="n5">
          <mxGeometry relative="1" as="geometry">
