        <mxCell id="n97" value="duration_ms / created_at   ·   INTEGER / TIMESTAMPTZ  保持30日" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10;" vertex="1" parent="t_api_history"><mxGeometry x="0" y="184" width="460" height="22" as="geometry" /></mxCell>
