        <mxCell id="n93" value="error_code / error_detail   ·   NULL可（エラー時は少なくとも一方）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10;" vertex="1" parent="t_api_history"><mxGeometry x="0" y="96" width="460" height="22" as="geometry" /></mxCell>
