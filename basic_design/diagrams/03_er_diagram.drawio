        <mxCell id="n104" value="error_code / error_detail   ·   NULL可（error時は少なくとも一方）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10;" vertex="1" parent="t_batch_history"><mxGeometry x="0" y="118" width="460" height="22" as="geometry" /></mxCell>
        <mxCell id="n105" value="target_count / success_count / skipped_count   ·   INTEGER  0以上" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10;" vertex="1" parent="t_batch_history"><mxGeometry x="0" y="140" width="460" height="22" as="geometry" /></mxCell>
