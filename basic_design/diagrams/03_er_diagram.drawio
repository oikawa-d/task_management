        <mxCell id="n61" value="Redis（永続化しない・TTLで自動失効）&lt;br&gt;&lt;br&gt;session:{session_id}        → user_id, role（TTL 30分・操作で延長）&lt;br&gt;csrf:{session_id}           → CSRFトークン（セッションと同一TTL）&lt;br&gt;refresh:{token_hash}        → user_id, family_id（TTL 14日）&lt;br&gt;user_sessions:{user_id}     → session_id の集合（強制ログアウト用）&lt;br&gt;user_refresh:{user_id}      → token_hash の集合&lt;br&gt;oauth_state:{state}         → PKCE検証値（TTL 10分・ワンタイム）&lt;br&gt;pwreset:{token_hash}        → user_id（TTL 30分・ワンタイム）&lt;br&gt;login_fail:{identifier}     → 連続失敗回数（TTL 15分）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="1080" y="130" width="460" height="230" as="geometry" />
        </mxCell>
        <mxCell id="n62" value="凡例 / 制約&lt;br&gt;PK（赤太字）: 主キー　UK（青太字）: 一意制約　FK（橙）: 外部キー&lt;br&gt;CASCADE / RESTRICT / SET NULL は ON DELETE の挙動&lt;br&gt;・project_members は (project_id, user_id) の複合主キー&lt;br&gt;・列挙値は ENUM 型ではなく VARCHAR + CHECK 制約で表現&lt;br&gt;・users.username / email は lower() の一意インデックス&lt;br&gt;・login_history は Redis の失効状況と独立して保持し続ける" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1080" y="390" width="460" height="160" as="geometry" />
        </mxCell>
        <mxCell id="n63" value="主なインデックス&lt;br&gt;ix_tasks_project_status_position (project_id, status, position)&lt;br&gt;　→ カンバン表示の主クエリ&lt;br&gt;ix_project_members_user_id (user_id)&lt;br&gt;　→ ダッシュボードの所属プロジェクト一覧&lt;br&gt;ix_task_comments_task_created (task_id, created_at)&lt;br&gt;ix_login_history_user_created (user_id, created_at DESC)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1080" y="580" width="460" height="150" as="geometry" />
        </mxCell>
        <mxCell id="n64" value="DB関数 / プロシージャ（db/functions・db/procedures）&lt;br&gt;trg_set_updated_at()        BEFORE UPDATE トリガ&lt;br&gt;fn_is_project_member(pid, uid) → BOOLEAN&lt;br&gt;fn_next_task_position(pid, status) → INTEGER&lt;br&gt;sp_purge_login_history(retention_days)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF9C4;strokeColor=#F9A825;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;size=14;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1080" y="760" width="460" height="110" as="geometry" />
        </mxCell>
      </root>
