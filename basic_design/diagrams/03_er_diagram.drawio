          <mxGeometry x="600" y="1260" width="460" height="250" as="geometry" />
        </mxCell>
        <mxCell id="n100" value="PK  id / UK  run_id   ·   UUID" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10;fontStyle=1;fontColor=#B71C1C;" vertex="1" parent="t_batch_history"><mxGeometry x="0" y="30" width="460" height="22" as="geometry" /></mxCell>
        <mxCell id="n101" value="batch_name / trigger_type / slot   ·   VARCHAR  NULL可" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10;" vertex="1" parent="t_batch_history"><mxGeometry x="0" y="52" width="460" height="22" as="geometry" /></mxCell>
        <mxCell id="n102" value="status   ·   inprogress|complete|error" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10;" vertex="1" parent="t_batch_history"><mxGeometry x="0" y="74" width="460" height="22" as="geometry" /></mxCell>
