          <mxGeometry x="330" y="110" width="760" height="700" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="frontend&lt;br&gt;node:26 build → nginx:alpine&lt;br&gt;&lt;br&gt;公開: ${FRONTEND_PORT} → 80&lt;br&gt;/api を backend へ proxy_pass" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
