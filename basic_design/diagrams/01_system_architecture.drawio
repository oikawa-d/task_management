        <mxCell id="n9" value="redis:8-alpine&lt;br&gt;&lt;br&gt;公開: ${REDIS_PORT} → 6379&lt;br&gt;volume なし / RDB・AOF 無効&lt;br&gt;maxmemory-policy=noeviction&lt;br&gt;ログイン状態のみ（TTL失効）" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFEBEE;strokeColor=#C62828;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
