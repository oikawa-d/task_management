        <mxCell id="n4" value="ブラウザ&lt;br&gt;（React SPA）&lt;br&gt;&lt;br&gt;session: Cookie 保持&lt;br&gt;jwt: access token をメモリ保持" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
