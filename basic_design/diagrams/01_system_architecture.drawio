        </mxCell>
        <mxCell id="n7" value="backend&lt;br&gt;python:3.14-slim / FastAPI + Uvicorn&lt;br&gt;&lt;br&gt;公開: ${BACKEND_PORT} → 8000&lt;br&gt;起動時 alembic upgrade head&lt;br&gt;AUTH_MODE = session | jwt" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="370" y="340" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="postgres:17-alpine&lt;br&gt;&lt;br&gt;公開: ${POSTGRES_PORT} → 5432&lt;br&gt;volume: pgdata（永続化あり）&lt;br&gt;永続データ 7テーブル" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFF3E0;strokeColor=#EF6C00;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="790" y="340" width="260" height="140" as="geometry" />
