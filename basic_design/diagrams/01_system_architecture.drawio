        <mxCell id="n2" value="タスク管理システム Cerberus / Docker Compose 単一ホスト構成（クラウド未使用）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#616161;" vertex="1" parent="1">
